[Unit]
Description=XBot 3 language learning bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/y/Programming/XBot 3
ExecStart="/home/y/Programming/XBot 3/venv/bin/python" -u main.py
Environment=HTTP_PROXY=http://127.0.0.1:7897
Environment=HTTPS_PROXY=http://127.0.0.1:7897
Environment=NO_PROXY=localhost,127.0.0.1,::1
Environment="BOT_CONSOLE_LOG=/home/y/Programming/XBot 3/data/console.log"
Restart=always
RestartSec=300
TimeoutStopSec=600

[Install]
WantedBy=default.target
